{
  "name": "expense-settlement-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript automation framework for Expense Settlement test cases",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  }
}
